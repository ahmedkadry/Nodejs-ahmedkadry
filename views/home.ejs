<div class="hero">
    <h1>Welcome to MyApp 🚀</h1>
    <p>A secure authentication system with user &amp; admin dashboards.</p>
    <% if (currentUser) { %>
        <a href="<%= currentUser.role === 'admin' ? '/admin/dashboard' : '/user/dashboard' %>"
            class="btn btn-primary">Go to Dashboard</a>
        <% } else { %>
            <a href="/register" class="btn btn-primary">Get Started</a>
            <a href="/login" class="btn btn-outline">Login</a>
            <% } %>
</div>